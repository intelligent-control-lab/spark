+    std::vector<double> JsonVector(
+      const nlohmann::json& object,
+      const std::string& key,
+      size_t expected_size,
+      const std::vector<double>& fallback) const {
+      if (!object.contains(key) || !object[key].is_array()) {
+        return fallback;
+      }
+      std::vector<double> values = object[key].get<std::vector<double>>();
+      if (values.size() != expected_size) {
+        std::ostringstream oss;
+        oss << key << " must have " << expected_size << " values, got " << values.size();
+        throw std::runtime_error(oss.str());
+      }
+      return values;
+    }
+
+    std::array<double, 3> JsonArray3(
+      const nlohmann::json& object,
+      const std::string& key,
+      const std::array<double, 3>& fallback) const {
+      if (!object.contains(key) || !object[key].is_array()) {
+        return fallback;
+      }
+      std::vector<double> values = object[key].get<std::vector<double>>();
+      if (values.size() != 3) {
+        std::ostringstream oss;
+        oss << key << " must have 3 values, got " << values.size();
+        throw std::runtime_error(oss.str());
+      }
+      return {values[0], values[1], values[2]};
+    }
+
+    std::array<float, 3> ToFloatArray3(const std::array<double, 3>& values) const {
+      return {
+        static_cast<float>(values[0]),
+        static_cast<float>(values[1]),
+        static_cast<float>(values[2])
+      };
+    }
+
+    std::array<float, 4> ToFloatArray4(const std::vector<double>& values) const {
+      if (values.size() != 4) {
+        std::ostringstream oss;
+        oss << "base_quat must have 4 values, got " << values.size();
+        throw std::runtime_error(oss.str());
+      }
+      return {
+        static_cast<float>(values[0]),
+        static_cast<float>(values[1]),
+        static_cast<float>(values[2]),
+        static_cast<float>(values[3])
+      };
+    }
+
+    void ApplySparkPolicyRequest(const nlohmann::json& request) {
+      std::vector<double> default_actuated(default_angles.begin(), default_angles.end());
+      std::vector<double> actuated_qpos;
+      if (request.contains("actuated_qpos")) {
+        actuated_qpos = JsonVector(request, "actuated_qpos", G1_NUM_MOTOR, default_actuated);
+      } else {
+        std::vector<double> body_qpos = JsonVector(request, "body_qpos", G1_NUM_MOTOR + 7, {});
+        if (body_qpos.size() != G1_NUM_MOTOR + 7) {
+          throw std::runtime_error("request must include actuated_qpos or full body_qpos");
+        }
+        actuated_qpos.assign(body_qpos.begin() + 7, body_qpos.begin() + 7 + G1_NUM_MOTOR);
+      }
+      std::vector<double> actuated_qvel = JsonVector(
+        request,
+        "actuated_qvel",
+        G1_NUM_MOTOR,
+        std::vector<double>(G1_NUM_MOTOR, 0.0)
+      );
+
+      std::vector<double> base_quat;
+      if (request.contains("base_quat")) {
+        base_quat = JsonVector(request, "base_quat", 4, {1.0, 0.0, 0.0, 0.0});
+      } else {
+        std::vector<double> body_qpos = JsonVector(request, "body_qpos", G1_NUM_MOTOR + 7, {});
+        if (body_qpos.size() != G1_NUM_MOTOR + 7) {
+          throw std::runtime_error("request must include base_quat or full body_qpos");
+        }
+        base_quat.assign(body_qpos.begin() + 3, body_qpos.begin() + 7);
+      }
+      const auto base_ang_vel = JsonArray3(request, "base_ang_vel", {0.0, 0.0, 0.0});
+
+      LowState_ low_state;
+      low_state.mode_pr(static_cast<uint8_t>(mode_pr_));
+      low_state.mode_machine(1);
+      low_state.imu_state().quaternion(ToFloatArray4(base_quat));
+      low_state.imu_state().gyroscope(ToFloatArray3(base_ang_vel));
+      low_state.imu_state().accelerometer({0.0f, 0.0f, -9.81f});
+      for (int i = 0; i < G1_NUM_MOTOR; ++i) {
+        auto& motor = low_state.motor_state()[i];
+        motor.mode(1);
+        motor.q(static_cast<float>(actuated_qpos[i]));
+        motor.dq(static_cast<float>(actuated_qvel[i]));
+        motor.ddq(0.0f);
+        motor.tau_est(0.0f);
+        motor.temperature({30, 30});
+        motor.motorstate(0);
+      }
+      low_state_buffer_.SetData(low_state);
+
+      IMUState_ imu_torso;
+      imu_torso.quaternion(ToFloatArray4(base_quat));
+      imu_torso.gyroscope(ToFloatArray3(base_ang_vel));
+      imu_torso.accelerometer({0.0f, 0.0f, -9.81f});
+      imu_torso_buffer_.SetData(imu_torso);
+      mode_machine_ = 1;
+
+      if (request.contains("upper_body_position")) {
+        const auto upper = JsonVector(request, "upper_body_position", 17, std::vector<double>(17, 0.0));
+        for (int i = 0; i < 17; ++i) {
+          upper_body_joint_positions_buffer_[i] = upper[i];
+        }
+        has_upper_body_data_ = true;
+      } else {
+        has_upper_body_data_ = false;
+      }
+
+      const auto upper_vel = JsonVector(
+        request,
+        "upper_body_velocity",
+        17,
+        std::vector<double>(17, 0.0)
+      );
+      for (int i = 0; i < 17; ++i) {
+        upper_body_joint_velocities_buffer_[i] = upper_vel[i];
+      }
+
+      const nlohmann::json planner_request =
+        (request.contains("planner") && request["planner"].is_object())
+          ? request["planner"]
+          : nlohmann::json::object();
+      const int mode = planner_request.value("mode", static_cast<int>(LocomotionMode::IDLE));
+      const auto movement = JsonArray3(planner_request, "movement", {0.0, 0.0, 0.0});
+      const auto facing = JsonArray3(planner_request, "facing", {1.0, 0.0, 0.0});
+      const double speed = planner_request.value("speed", -1.0);
+      const double height = planner_request.value("height", -1.0);
+      movement_state_buffer_.SetData(MovementState(mode, movement, facing, speed, height));
+
+      if (planner_) {
+        planner_->planner_state_.enabled = true;
+      }
+      operator_state.start = request.value("start", true);
+      operator_state.play = true;
+    }
+
+    bool RunSparkPolicyTick(std::string& error_message) {
+      try {
+        logging_counter_++;
+
+        if (planner_ && planner_->planner_state_.enabled) {
+          Planner();
+        }
+
+        if (!GatherRobotStateToLogger()) {
+          error_message = "failed to gather robot state";
+          return false;
+        }
+
+        int current_frame_copy = 0;
+        int current_encoder_mode_copy = initial_encoder_mode_;
+        bool current_play_copy = operator_state.play;
+        std::shared_ptr<const MotionSequence> current_motion_copy = nullptr;
+        {
+          std::lock_guard<std::mutex> lock(current_motion_mutex_);
+          if (!current_motion_ || current_motion_->timesteps == 0) {
+            error_message = "current motion is empty";
+            return false;
+          }
+          current_frame_copy = current_frame_;
+          current_motion_copy = current_motion_;
+          current_encoder_mode_copy = current_motion_copy->GetEncodeMode();
+          saved_frame_for_observation_window_ = 0;
+          UpdateHeadingState();
+          if (!GatherObservations()) {
+            error_message = "failed to gather observations";
+            return false;
+          }
+        }
+
+        if (state_logger_ && current_motion_copy) {
+          const std::string motion_name = current_motion_copy->name;
+          state_logger_->LogPostState(
+            std::span(token_state_data_),
+            current_encoder_mode_copy,
+            motion_name,
+            current_play_copy
+          );
+        }
+
+        if (!CreatePolicyCommand()) {
+          error_message = "policy inference failed";
+          return false;
+        }
+
+        if (!CurrentFrameAdvancement()) {
+          error_message = "failed to advance current frame";
+          return false;
+        }
+
+        (void)current_frame_copy;
+        return true;
+      } catch (const std::exception& e) {
+        error_message = e.what();
+        return false;
+      }
+    }
+
+    nlohmann::json BuildSparkPolicyResponse(const nlohmann::json& request, bool ok, const std::string& error_message) const {
+      nlohmann::json response;
+      response["ok"] = ok;
+      response["seq"] = request.value("seq", -1);
+      if (!ok) {
+        response["error"] = error_message;
+        return response;
+      }
+
+      const std::shared_ptr<const MotorCommand> mc = motor_command_buffer_.GetDataWithTime().data;
+      if (!mc) {
+        response["ok"] = false;
+        response["error"] = "motor command is unavailable";
+        return response;
+      }
+
+      std::vector<double> target_actuated_pos;
+      std::vector<double> motor_kps;
+      std::vector<double> motor_kds;
+      target_actuated_pos.reserve(G1_NUM_MOTOR);
+      motor_kps.reserve(G1_NUM_MOTOR);
+      motor_kds.reserve(G1_NUM_MOTOR);
+      for (int i = 0; i < G1_NUM_MOTOR; ++i) {
+        target_actuated_pos.push_back(static_cast<double>(mc->q_target.at(i)));
+        motor_kps.push_back(static_cast<double>(mc->kp.at(i)));
+        motor_kds.push_back(static_cast<double>(mc->kd.at(i)));
+      }
+
+      response["target_actuated_pos"] = target_actuated_pos;
+      response["motor_kps"] = motor_kps;
+      response["motor_kds"] = motor_kds;
+      response["debug"] = {
+        {"backend", "g1_deploy_onnx_ref_spark_policy_server"},
+        {"planner_enabled", planner_ ? planner_->planner_state_.enabled : false},
+        {"planner_initialized", planner_ ? planner_->planner_state_.initialized : false},
+        {"current_frame", current_frame_}
+      };
+      return response;
+    }
+
+    void RunSparkPolicyServer(const std::string& endpoint) {
+      if (!policy_server_mode_) {
+        throw std::runtime_error("RunSparkPolicyServer called when policy_server_mode_ is false");
+      }
+      zmq::context_t context(1);
+      zmq::socket_t socket(context, zmq::socket_type::rep);
+      socket.set(zmq::sockopt::linger, 0);
+      socket.bind(endpoint);
+      std::cout << "[SparkPolicyServer] Listening on " << endpoint << std::endl;
+
+      while (!operator_state.stop) {
+        zmq::message_t message;
+        auto recv_result = socket.recv(message, zmq::recv_flags::none);
+        if (!recv_result.has_value()) {
+          continue;
+        }
+
+        nlohmann::json request;
+        nlohmann::json response;
+        std::string error_message;
+        bool ok = false;
+        try {
+          request = nlohmann::json::parse(
+            static_cast<const char*>(message.data()),
+            static_cast<const char*>(message.data()) + message.size()
+          );
+          ApplySparkPolicyRequest(request);
+          ok = RunSparkPolicyTick(error_message);
+          response = BuildSparkPolicyResponse(request, ok, error_message);
+        } catch (const std::exception& e) {
+          response = {
+            {"ok", false},
+            {"seq", request.value("seq", -1)},
+            {"error", e.what()}
+          };
+        }
+
+        const std::string payload = response.dump();
+        socket.send(zmq::buffer(payload), zmq::send_flags::none);
+      }
+    }
