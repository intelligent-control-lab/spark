+    bool PrepareSparkEncoderInput(
+        std::string& error_message, float* destination,
+        size_t expected_dimension, bool run_planner = true) {
+      try {
+        logging_counter_++;
+        if (run_planner && planner_ && planner_->planner_state_.enabled) Planner();
+        if (!GatherRobotStateToLogger()) {
+          error_message = "failed to gather robot state";
+          return false;
+        }
+        if (!encoder_engine_ ||
+            encoder_engine_->GetInputDimension() != expected_dimension) {
+          error_message = "encoder input dimension mismatch";
+          return false;
+        }
+        std::lock_guard<std::mutex> lock(current_motion_mutex_);
+        if (!current_motion_ || current_motion_->timesteps == 0) {
+          error_message = "current motion is empty";
+          return false;
+        }
+        saved_frame_for_observation_window_ = 0;
+        UpdateHeadingState();
+        if (!GatherEncoderObservations()) {
+          error_message = "failed to gather encoder observations";
+          return false;
+        }
+        const auto& input = encoder_engine_->GetInputBuffer();
+        std::copy_n(input.data(), expected_dimension, destination);
+        return true;
+      } catch (const std::exception& e) {
+        error_message = e.what();
+        return false;
+      }
+    }
+
+    bool ApplySparkEncoderToken(const float* token, size_t dimension) {
+      if (token == nullptr || dimension != token_state_data_.size()) return false;
+      std::transform(token, token + dimension, token_state_data_.begin(),
+                     [](float value) { return static_cast<double>(value); });
+      spark_batch_token_ready_ = true;
+      return true;
+    }
