+static MotionDataReader LoadMotionDataCached(const std::string& path) {
+  static std::mutex cache_mutex;
+  static std::map<std::string, MotionDataReader> cache;
+  std::lock_guard<std::mutex> lock(cache_mutex);
+  auto found = cache.find(path);
+  if (found == cache.end()) {
+    MotionDataReader loaded;
+    if (!loaded.ReadFromCSV(path) || loaded.motions.empty()) {
+      throw std::runtime_error("failed to load motion data from " + path);
+    }
+    found = cache.emplace(path, std::move(loaded)).first;
+  }
+  MotionDataReader result;
+  result.motions.reserve(found->second.motions.size());
+  for (const auto& motion : found->second.motions) {
+    result.motions.push_back(std::make_shared<MotionSequence>(*motion));
+  }
+  return result;
+}
