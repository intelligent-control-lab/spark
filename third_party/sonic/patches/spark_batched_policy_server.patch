+    {
+        int deviceCount = 0;
+        cudaGetDeviceCount( &deviceCount );
+
+        if ( deviceID >= deviceCount )
+            return std::string();
+
+        cudaDeviceProp prop;
+        cudaGetDeviceProperties( &prop, deviceID );
+        return std::string( prop.name );
