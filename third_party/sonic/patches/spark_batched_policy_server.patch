+    bool FinishSparkPolicyTick(
+        const float* action, std::string& error_message) {
+      if (!ApplyPolicyAction(action)) {
+        error_message = "failed to apply policy action";
+        return false;
+      }
+      if (!CurrentFrameAdvancement()) {
+        error_message = "failed to advance current frame";
+        return false;
+      }
+      return true;
+    }
+
+    bool RunSparkPolicyTick(std::string& error_message) {
+      if (!PrepareSparkPolicyTick(error_message)) return false;
+      if (!CreatePolicyCommand()) {
+        error_message = "policy inference failed";
+        return false;
+      }
+      if (!CurrentFrameAdvancement()) {
+        error_message = "failed to advance current frame";
+        return false;
+      }
+      return true;
+    }
