+    nlohmann::json BuildSparkPolicyResponse(const nlohmann::json& request, bool ok, const std::string& error_message) const {
+      nlohmann::json response;
+      response["ok"] = ok;
+      response["seq"] = request.value("seq", -1);
+      if (!ok) {
+        response["error"] = error_message;
+        return response;
+      }
+
+      const std::shared_ptr<const MotorCommand> mc = motor_command_buffer_.GetDataWithTime().data;
+      if (!mc) {
+        response["ok"] = false;
+        response["error"] = "motor command is unavailable";
+        return response;
+      }
+
+      std::vector<double> target_actuated_pos;
+      std::vector<double> motor_kps;
+      std::vector<double> motor_kds;
+      target_actuated_pos.reserve(G1_NUM_MOTOR);
+      motor_kps.reserve(G1_NUM_MOTOR);
+      motor_kds.reserve(G1_NUM_MOTOR);
+      for (int i = 0; i < G1_NUM_MOTOR; ++i) {
+        target_actuated_pos.push_back(static_cast<double>(mc->q_target.at(i)));
+        motor_kps.push_back(static_cast<double>(mc->kp.at(i)));
+        motor_kds.push_back(static_cast<double>(mc->kd.at(i)));
+      }
+
+      response["target_actuated_pos"] = target_actuated_pos;
+      response["motor_kps"] = motor_kps;
+      response["motor_kds"] = motor_kds;
+      response["debug"] = {
+        {"backend", "g1_deploy_onnx_ref_spark_policy_server"},
+        {"planner_enabled", planner_ ? planner_->planner_state_.enabled : false},
+        {"planner_initialized", planner_ ? planner_->planner_state_.initialized : false},
+        {"current_frame", current_frame_}
+      };
+      return response;
+    }
+
+    void RunSparkPolicyServer(const std::string& endpoint) {
+      if (!policy_server_mode_) {
+        throw std::runtime_error("RunSparkPolicyServer called when policy_server_mode_ is false");
+      }
+      zmq::context_t context(1);
+      zmq::socket_t socket(context, zmq::socket_type::rep);
+      socket.set(zmq::sockopt::linger, 0);
+      socket.bind(endpoint);
+      std::cout << "[SparkPolicyServer] Listening on " << endpoint << std::endl;
+
+      while (!operator_state.stop) {
+        zmq::message_t message;
+        auto recv_result = socket.recv(message, zmq::recv_flags::none);
+        if (!recv_result.has_value()) {
+          continue;
+        }
+
+        nlohmann::json request;
+        nlohmann::json response;
+        std::string error_message;
+        bool ok = false;
+        try {
+          request = nlohmann::json::parse(
+            static_cast<const char*>(message.data()),
+            static_cast<const char*>(message.data()) + message.size()
+          );
+          ApplySparkPolicyRequest(request);
+          ok = RunSparkPolicyTick(error_message);
+          response = BuildSparkPolicyResponse(request, ok, error_message);
+        } catch (const std::exception& e) {
+          response = {
+            {"ok", false},
+            {"seq", request.value("seq", -1)},
+            {"error", e.what()}
+          };
+        }
+
+        const std::string payload = response.dump();
+        socket.send(zmq::buffer(payload), zmq::send_flags::none);
+      }
+    }
+
+    void RunSparkPolicyBatchServer(
+        const std::string& endpoint,
+        const std::vector<G1Deploy*>& sessions,
+        const std::string& batch_policy_file,
+        const std::string& batch_encoder_file,
+        const std::string& batch_planner_file,
+        bool policy_fp16,
+        bool planner_fp16) {
+      if (sessions.empty()) {
+        throw std::runtime_error("SPARK batch server requires at least one session");
+      }
+      PolicyEngine batch_policy;
+      if (!batch_policy.Initialize(
+              batch_policy_file, policy_fp16, sessions.size())) {
+        throw std::runtime_error("failed to initialize batched policy engine");
+      }
+      const size_t observation_dimension =
+          sessions.front()->PolicyObservationDimension();
+      if (batch_policy.GetInputDimension() != observation_dimension) {
+        throw std::runtime_error("batched policy observation dimension mismatch");
+      }
+      EncoderEngine batch_encoder;
+      if (!batch_encoder.Initialize(
+              batch_encoder_file, false, sessions.size())) {
+        throw std::runtime_error("failed to initialize batched encoder engine");
+      }
+      const size_t encoder_dimension = batch_encoder.GetInputDimension();
+      const size_t token_dimension = batch_encoder.GetTokenDimension();
+      auto* template_planner = sessions.front()->SparkTensorRTPlanner();
+      if (!template_planner) {
+        throw std::runtime_error("SPARK batch server requires TensorRT planners");
+      }
+      PlannerConfig batch_planner_config = template_planner->GetConfig();
+      batch_planner_config.model_path = batch_planner_file;
+      LocalMotionPlannerTensorRT batch_planner(
+          planner_fp16, 0, batch_planner_config, sessions.size());
+
+      zmq::context_t context(1);
+      zmq::socket_t socket(context, zmq::socket_type::rep);
+      socket.set(zmq::sockopt::linger, 0);
+      socket.bind(endpoint);
+      std::cout << "[SparkPolicyBatchServer] Listening on " << endpoint
+                << " with " << sessions.size() << " independent sessions" << std::endl;
+
+      while (!sessions.front()->operator_state.stop) {
+        zmq::message_t message;
+        if (!socket.recv(message, zmq::recv_flags::none).has_value()) continue;
+        nlohmann::json envelope;
+        nlohmann::json response;
+        try {
+          envelope = nlohmann::json::parse(
+              static_cast<const char*>(message.data()),
+              static_cast<const char*>(message.data()) + message.size());
+          const auto& requests = envelope.is_array() ? envelope : envelope.at("requests");
+          if (!requests.is_array() || requests.size() != sessions.size()) {
+            throw std::runtime_error(
+                "batch request count must equal configured SPARK session count");
+          }
+          std::vector<bool> prepared(sessions.size(), false);
+          std::vector<bool> planner_prepared(sessions.size(), false);
+          std::vector<std::string> errors(sessions.size());
+          std::vector<int> encoder_modes(sessions.size(), -1);
+          auto& batch_encoder_observations = batch_encoder.GetInputBuffer();
+          for (size_t index = 0; index < sessions.size(); ++index) {
+            try {
+              sessions[index]->ApplySparkPolicyRequest(requests[index]);
+              planner_prepared[index] =
+                  sessions[index]->PrepareSparkPlannerInference();
+            } catch (const std::exception& e) {
+              errors[index] = e.what();
+            }
+          }
+          if (std::any_of(planner_prepared.begin(), planner_prepared.end(),
+                          [](bool value) { return value; })) {
+            std::vector<LocalMotionPlannerTensorRT*> planners;
+            planners.reserve(sessions.size());
+            for (auto* session : sessions) {
+              planners.push_back(session->SparkTensorRTPlanner());
+            }
+            const auto planner_batch_start = std::chrono::steady_clock::now();
+            if (!batch_planner.RunBatch(planners)) {
+              throw std::runtime_error("batched planner inference failed");
