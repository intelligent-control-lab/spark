  <!--
    Lightweight articulated Robotiq 2F-85 display matching
    iiwa14_2f85_single.xml. The two prismatic joints approximate the coupled
    four-bar travel without adding the gripper to SPARK's seven arm DoFs.
  -->
  <material name="spark_gripper_black"><color rgba="0.08 0.09 0.11 1"/></material>
  <material name="spark_gripper_gray"><color rgba="0.46 0.46 0.46 1"/></material>
  <link name="spark_robotiq_2f85_base">
    <inertial><origin xyz="0 0 0"/><mass value="0.001"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
    <visual><origin xyz="0 0 0.057" rpy="0 0 0"/><geometry><mesh filename="./meshes/robotiq_2f85/base_mount.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_black"/></visual>
    <visual name="spark_gripper_base"><origin xyz="0 0 0.0608" rpy="0 0 -1.57079633"/><geometry><mesh filename="./meshes/robotiq_2f85/base.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_black"/></visual>
  </link>
  <joint name="spark_robotiq_2f85_mount" type="fixed">
    <parent link="iiwa_link_7"/><child link="spark_robotiq_2f85_base"/>
  </joint>

  <link name="spark_robotiq_right_finger">
    <inertial><origin xyz="0.045 0 0.145"/><mass value="0.02"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/></inertial>
    <visual><origin xyz="0.0306011 0 0.115704" rpy="0 0 -1.57079633"/><geometry><mesh filename="./meshes/robotiq_2f85/driver.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_gray"/></visual>
    <visual><origin xyz="0.0621011 0 0.111604" rpy="0 0 -1.57079633"/><geometry><mesh filename="./meshes/robotiq_2f85/coupler.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_black"/></visual>
    <visual><origin xyz="0.0132 0 0.1217" rpy="0 0 -1.57079633"/><geometry><mesh filename="./meshes/robotiq_2f85/spring_link.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_black"/></visual>
    <visual><origin xyz="0.0682 0 0.1592" rpy="0 0 -1.57079633"/><geometry><mesh filename="./meshes/robotiq_2f85/follower.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_black"/></visual>
    <visual><origin xyz="0.0493 0 0.17272" rpy="0 0 -1.57079633"/><geometry><mesh filename="./meshes/robotiq_2f85/pad.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_gray"/></visual>
    <visual><origin xyz="0.0493 0 0.17272" rpy="0 0 -1.57079633"/><geometry><mesh filename="./meshes/robotiq_2f85/silicone_pad.stl" scale="0.001 0.001 0.001"/></geometry><material name="spark_gripper_black"/></visual>
  </link>
  <joint name="spark_robotiq_right_finger_joint" type="prismatic">
    <parent link="spark_robotiq_2f85_base"/><child link="spark_robotiq_right_finger"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.035" upper="0" effort="60" velocity="0.2"/>
    <dynamics damping="5" friction="0.1"/>
  </joint>

