<?xml version="1.0"?>
<!--
  Dual FANUC LR Mate 200iD/7L articulation for SPARK.

  Each arm is the ROS-Industrial-derived chain from lrmate200id7l.urdf. The
  fixed base transforms match lrmate200id_dual.xml. See README.md and
  LICENSE.ros_industrial_fanuc for provenance and license.
-->
<robot name="fanuc_lrmate200id7l_dual">
  <material name="fanuc_gray28">
    <color rgba="0.28 0.28 0.28 1"/>
  </material>
  <material name="fanuc_yellow">
    <color rgba="0.96 0.76 0.13 1"/>
  </material>
  <material name="fanuc_black">
    <color rgba="0.15 0.15 0.15 1"/>
  </material>
  <material name="spark_gripper_black"><color rgba="0.12 0.13 0.15 1"/></material>

  <link name="world"/>

  <link name="right_base_link">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/base_link.stl"/></geometry>
      <material name="fanuc_gray28"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/base_link.stl"/></geometry>
    </collision>
  </link>
  <joint name="world_to_right_base_link" type="fixed">
    <origin xyz="0 -0.45 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="right_base_link"/>
  </joint>

  <link name="right_link_1">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/link_1.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/link_1.stl"/></geometry>
    </collision>
  </link>
  <joint name="right_joint_1" type="revolute">
    <origin xyz="0 0 0.330" rpy="0 0 0"/>
    <parent link="right_base_link"/>
    <child link="right_link_1"/>
    <axis xyz="0 0 1"/>
    <limit effort="500" lower="-3.141592654" upper="3.141592654" velocity="6.457718232"/>
    <dynamics damping="5.0"/>
  </joint>

  <link name="right_link_2">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/link_2.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/link_2.stl"/></geometry>
    </collision>
  </link>
  <joint name="right_joint_2" type="revolute">
    <origin xyz="0.050 0 0" rpy="0 0 0"/>
    <parent link="right_link_1"/>
    <child link="right_link_2"/>
    <axis xyz="0 1 0"/>
    <limit effort="500" lower="-2.138028334" upper="2.138028334" velocity="5.410520681"/>
    <dynamics damping="5.0"/>
  </joint>

  <link name="right_link_3">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/link_3.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/link_3.stl"/></geometry>
    </collision>
  </link>
  <joint name="right_joint_3" type="revolute">
    <origin xyz="0 0 0.440" rpy="0 0 0"/>
    <parent link="right_link_2"/>
    <child link="right_link_3"/>
    <axis xyz="0 -1 0"/>
    <limit effort="80" lower="-3.752457892" upper="3.752457892" velocity="7.155849934"/>
    <dynamics damping="3.0"/>
  </joint>

  <link name="right_link_4">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/link_4.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/link_4.stl"/></geometry>
    </collision>
  </link>
  <joint name="right_joint_4" type="revolute">
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <parent link="right_link_3"/>
    <child link="right_link_4"/>
    <axis xyz="-1 0 0"/>
    <limit effort="40" lower="-3.316125579" upper="3.316125579" velocity="9.599310885"/>
    <dynamics damping="2.0"/>
  </joint>

  <link name="right_link_5">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/link_5.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/link_5.stl"/></geometry>
    </collision>
