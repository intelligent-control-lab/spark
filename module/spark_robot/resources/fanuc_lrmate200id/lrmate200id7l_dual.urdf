  <joint name="right_joint_5" type="revolute">
    <origin xyz="0.420 0 0" rpy="0 0 0"/>
    <parent link="right_link_4"/>
    <child link="right_link_5"/>
    <axis xyz="0 -1 0"/>
    <limit effort="30" lower="-2.181661565" upper="2.181661565" velocity="9.512536902"/>
    <dynamics damping="1.5"/>
  </joint>

  <link name="right_link_6">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/link_6.stl"/></geometry>
      <material name="fanuc_black"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/link_6.stl"/></geometry>
    </collision>
  </link>
  <joint name="right_joint_6" type="revolute">
    <origin xyz="0.080 0 0" rpy="0 0 0"/>
    <parent link="right_link_5"/>
    <child link="right_link_6"/>
    <axis xyz="-1 0 0"/>
    <limit effort="20" lower="-6.283185307" upper="6.283185307" velocity="17.453292520"/>
    <dynamics damping="1.0"/>
  </joint>

  <link name="right_flange"/>
  <joint name="right_link_6_to_flange" type="fixed">
    <parent link="right_link_6"/>
    <child link="right_flange"/>
  </joint>
  <link name="right_tool0"/>
  <joint name="right_flange_to_tool0" type="fixed">
    <origin xyz="0 0 0" rpy="3.141592654 -1.570796327 0"/>
    <parent link="right_flange"/>
    <child link="right_tool0"/>
  </joint>

  <link name="left_base_link">
    <visual>
      <geometry><mesh filename="./meshes/lrmate200id/base_link.stl"/></geometry>
      <material name="fanuc_gray28"/>
    </visual>
    <collision>
      <geometry><mesh filename="./meshes/lrmate200id/base_link.stl"/></geometry>
